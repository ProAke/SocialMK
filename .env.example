# SocialMK API (Beta) — copy to .env and adjust before deploying.
# All variables are optional; the API falls back to safe dev defaults.

# HTTP
PORT=4000
HOST=0.0.0.0

# Signing secret for session tokens. REQUIRED in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SOCIALMK_JWT_SECRET=

# Where the SQLite database and generated media live (default: apps/api/data)
# SOCIALMK_DATA_DIR=/var/lib/socialmk
